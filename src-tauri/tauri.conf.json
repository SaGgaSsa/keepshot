{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeepShot",
  "version": "0.1.5",
  "identifier": "dev.keepshot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "KeepShot Settings",
        "width": 560,
        "height": 680,
        "transparent": true,
        "center": true,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb", "rpm"],
    "publisher": "SaGgaSsa",
    "copyright": "Copyright (c) 2026 SaGgaSsa. MIT License.",
    "category": "Utility",
    "shortDescription": "Lightweight screenshot tool with local history",
    "longDescription": "KeepShot is a lightweight, open source screenshot tool with multi-monitor capture, re-editable annotations and a local capture history.",
    "homepage": "https://github.com/SaGgaSsa/keepshot",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": [
          "English",
          "Spanish"
        ]
      }
    },
    "linux": {
      "appimage": { "bundleMediaFramework": false },
      "deb": { "depends": [] },
      "rpm": {}
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2MjYxQjQxRkEyOEJEMjIKUldRaXZTajZRUnNtZGdYZlJLNTN4YlpuNVQ5TFIwNXppMkpNaFhOT2pqOUhNS2djUkplV2lDZTIK",
      "endpoints": [
        "https://github.com/SaGgaSsa/keepshot/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
